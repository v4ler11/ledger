# Copy to .env and fill in:  cp .env.example .env
# Used by the docker-compose.*.yml files in the project root (server and
# client variants, dev and prod). Client composes only need the optional vars.

# Required — Telegram bot token and the chat/user id the bot answers to.
LEDGER_TG_BOT_TOKEN=
LEDGER_TG_TARGET_USER_ID=
LEDGER_OPENROUTER_API_KEY=

# Ledger root file inside the writer repo (mounted at /data in the bot).
LEDGER_PATH=/data/main.bean
# Where the writer's git checkout lives on disk (shared by both containers).
LEDGER_DATA_DIR=./data
# Bind address/port for the MCP HTTP/SSE server (served beside the TG bot).
LEDGER_MCP_HOST=0.0.0.0
LEDGER_MCP_PORT=8000
# Timezone for the writer's hourly/daily commit boundaries.
TZ=Europe/Lisbon
