# Reader container: read-only mirror of the private repo. Fetches every
# PULL_INTERVAL seconds (default 5 min) and hard-resets the working tree
# to origin/$BRANCH, so the writer's daily history rewrites are followed
# without conflict. Run one per consumer; the writer is the only pusher.
#
# Build:   docker build -f Dockerfile.reader -t finances-reader .
# Run:     docker run -d --name finances-reader --restart unless-stopped \
#            -e REPO_URL=ssh://git@ssh.git.valerii.casa/valerii/finances.git \
#            -e TZ=Europe/Kyiv \
#            -v ~/.ssh/id_rsa:/root/.ssh/id_rsa:ro \
#            -v "$PWD":/repo \
#            finances-reader
#
# Notes:
#   * The key needs read access to the repo (same key works if allowed).
#   * Uncommitted local changes in /repo are stashed (not silently destroyed)
#     when an update resets the tree; recover via `git stash list`.

FROM alpine:3.20

RUN apk add --no-cache git openssh-client \
 && mkdir -p /root/.ssh && chmod 700 /root/.ssh

COPY reader.sh /usr/local/bin/reader.sh
RUN chmod +x /usr/local/bin/reader.sh

WORKDIR /repo

ENV REPO_DIR=/repo \
    BRANCH=main \
    SSH_KEY_PATH=/root/.ssh/id_rsa \
    PULL_INTERVAL=300

# Unhealthy when no fetch has succeeded within 2*PULL_INTERVAL + 90s
# (the reader touches .ledgerd.health after every successful fetch).
HEALTHCHECK --interval=1m --timeout=10s --start-period=30s --retries=3 \
  CMD test "$(( $(date +%s) - $(stat -c %Y "$REPO_DIR/.ledgerd.health" 2>/dev/null || echo 0) ))" -lt $(( PULL_INTERVAL * 2 + 90 ))

ENTRYPOINT ["/usr/local/bin/reader.sh"]